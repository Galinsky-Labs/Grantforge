# Copy to .env and fill in. Every value is optional except the LLM key (or GF_LLM_PROVIDER=mock).

# ----- LLM --------------------------------------------------------------
ANTHROPIC_API_KEY=
GF_LLM_PROVIDER=anthropic          # anthropic | mock (mock = offline dry run with canned answers)
GF_LLM_MODEL=claude-sonnet-5-5     # any current Claude model id
GF_LLM_MAX_TOKENS=8000             # per draft; raise for long narratives
GF_ENABLE_WEB_SEARCH_SOURCE=false  # true = also search the web for foundation/state/prize funding (uses the model's web-search tool)
GF_WEB_SEARCH_MAX_USES=8

# ----- Web app ----------------------------------------------------------
GF_BASE_URL=http://localhost:8000  # public URL used inside the review-link emails
GF_UI_PASSWORD=                    # set this before exposing the app beyond localhost
# GF_APP_SECRET=                   # auto-generated and persisted in data/.app_secret if blank
# GF_DATA_DIR=./data               # uploads, packages, outbox, SQLite database
# GF_DATABASE_URL=sqlite:///data/grantforge.db

# ----- Matching ---------------------------------------------------------
GF_MATCH_THRESHOLD=65              # minimum fit score (0-100) to shortlist and draft
GF_MAX_CANDIDATES_PER_QUERY=50     # Grants.gov rows per search query
GF_MAX_DRAFTS_PER_RUN=8            # drafts written per run (each is a long model call)
GF_MIN_DAYS_TO_DEADLINE=7          # skip opportunities closing sooner than this
GF_INCLUDE_FORECASTED=true         # include forecasted (not yet open) federal opportunities

# ----- Email (review notifications and email submissions) ---------------
GF_EMAIL_BACKEND=console           # console (writes .eml files to data/outbox) | smtp
GF_NOTIFY_TO=you@example.com       # where review links are sent
GF_EMAIL_FROM=you@example.com
GF_SMTP_HOST=smtp.gmail.com        # for Gmail use an App Password, not your login password
GF_SMTP_PORT=587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_STARTTLS=true

# ----- Submission -------------------------------------------------------
GF_ALLOW_EMAIL_SUBMISSION=true     # false = never email funders; always prepare a manual package instead
GF_SUBMISSION_TEST_MODE=true       # true = authorized email submissions go to GF_SUBMISSION_TEST_RECIPIENT (or GF_NOTIFY_TO) instead of the funder.
                                   # Set to false only after you have seen a test submission arrive and look right.
GF_SUBMISSION_TEST_RECIPIENT=
# GF_GRANTS_GOV_S2S_CERT=          # PEM paths for Grants.gov System-to-System (see grantforge/submit/grants_gov_s2s.py)
# GF_GRANTS_GOV_S2S_KEY=

# ----- Autopilot --------------------------------------------------------
GF_AUTOPILOT_INTERVAL_HOURS=0      # e.g. 24 = re-search, re-score and draft new matches daily, emailing you only when there is something new
