# Copy to .env and fill in. Required for real use: ANTHROPIC_API_KEY, GF_NOTIFY_TO, the SMTP settings,
# and (for a public server) GF_DOMAIN, GF_BASE_URL and GF_UI_PASSWORD.

# ----- LLM --------------------------------------------------------------
ANTHROPIC_API_KEY=
# GF_LLM_PROVIDER: anthropic | mock (mock = offline dry run with canned answers)
GF_LLM_PROVIDER=anthropic
# GF_LLM_MODEL: $2 / $10 per million input/output tokens (Anthropic pricing page, checked 2026-11-01)
GF_LLM_MODEL=claude-sonnet-5-5
# GF_LLM_MAX_TOKENS: cap for planning and other single calls
GF_LLM_MAX_TOKENS=8000
# GF_SECTION_MAX_TOKENS: cap per application section
GF_SECTION_MAX_TOKENS=6000
# GF_FACT_CHECK: check every section's claims against your material
GF_FACT_CHECK=true
# GF_WORDS_PER_PAGE: used to estimate page limits (single-spaced, 12 pt)
GF_WORDS_PER_PAGE=500
# GF_ENABLE_WEB_SEARCH_SOURCE: true = also search the web for foundation/state/prize funding ($10 per 1,000 searches plus tokens)
GF_ENABLE_WEB_SEARCH_SOURCE=false
GF_WEB_SEARCH_MAX_USES=8
GF_WEB_SEARCH_TOOL_VERSION=web_search_20260318

# ----- Spend control ----------------------------------------------------
# GF_MONTHLY_BUDGET_USD: all model calls stop for the month at this spend; 0 = no cap
GF_MONTHLY_BUDGET_USD=30
# GF_PRICE_INPUT_PER_MTOK: only for a model not in grantforge/llm.py's price table
# GF_PRICE_INPUT_PER_MTOK=
# GF_PRICE_OUTPUT_PER_MTOK=

# ----- Web app ----------------------------------------------------------
# GF_BASE_URL: public address used in review-link emails; https://<GF_DOMAIN> on a server
GF_BASE_URL=http://localhost:8000
# GF_DOMAIN: e.g. grants.example.com (used by the bundled Caddy HTTPS proxy)
GF_DOMAIN=
# GF_UI_PASSWORD: required whenever GF_BASE_URL is not localhost; also required to Authorize
GF_UI_PASSWORD=
# GF_REVIEW_LINK_DAYS: review links in emails stop working after this many days
GF_REVIEW_LINK_DAYS=14
GF_SESSION_DAYS=30
# GF_MAX_UPLOAD_MB: per file
GF_MAX_UPLOAD_MB=200
# GF_TRUST_PROXY: deploy.sh sets true when running behind the bundled Caddy
GF_TRUST_PROXY=false
# GF_APP_SECRET: auto-generated and kept in data/.app_secret if blank
# GF_APP_SECRET=
# GF_DATA_DIR: uploads, packages, outbox, backups, SQLite database
# GF_DATA_DIR=./data

# ----- Matching ---------------------------------------------------------
# GF_MATCH_THRESHOLD: minimum fit score (0-100) to draft
GF_MATCH_THRESHOLD=65
# GF_MAX_CANDIDATES_PER_QUERY: Grants.gov rows per search query
GF_MAX_CANDIDATES_PER_QUERY=50
# GF_MAX_DRAFTS_PER_RUN: drafts written per run
GF_MAX_DRAFTS_PER_RUN=8
# GF_MIN_DAYS_TO_DEADLINE: skip opportunities closing sooner than this
GF_MIN_DAYS_TO_DEADLINE=7
# GF_INCLUDE_FORECASTED: forecasted opportunities are listed and held, then drafted once posted
GF_INCLUDE_FORECASTED=true

# ----- Email (review notifications, reminders, email submissions) -------
# GF_EMAIL_BACKEND: console (writes .eml files to data/outbox) | smtp
GF_EMAIL_BACKEND=console
GF_NOTIFY_TO=you@example.com
GF_EMAIL_FROM=you@example.com
# GF_SMTP_HOST: Gmail needs 2-step verification and an App Password
GF_SMTP_HOST=smtp.gmail.com
GF_SMTP_PORT=587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_STARTTLS=true
# GF_REMINDER_DAYS: deadline reminders for unsubmitted drafts
GF_REMINDER_DAYS=7,2

# ----- Submission -------------------------------------------------------
# GF_ALLOW_EMAIL_SUBMISSION: false = never email funders; always prepare a package instead
GF_ALLOW_EMAIL_SUBMISSION=true
# GF_SUBMISSION_TEST_MODE: true = authorized email submissions go to you, not the funder
GF_SUBMISSION_TEST_MODE=true
GF_SUBMISSION_TEST_RECIPIENT=
# GF_GRANTS_GOV_S2S_CERT: see grantforge/submit/grants_gov_s2s.py
# GF_GRANTS_GOV_S2S_CERT=
# GF_GRANTS_GOV_S2S_KEY=

# ----- Operations -------------------------------------------------------
# GF_AUTOPILOT_INTERVAL_HOURS: e.g. 24 = search, score and draft new matches daily
GF_AUTOPILOT_INTERVAL_HOURS=0
# GF_BACKUP_KEEP: daily backup archives kept
GF_BACKUP_KEEP=14
# GF_BACKUP_DIR: e.g. a mounted volume or synced folder for off-server copies
# GF_BACKUP_DIR=
GF_OCR=true
# GF_RUN_WORKER: run exactly one worker; set false on any additional web process
GF_RUN_WORKER=true
